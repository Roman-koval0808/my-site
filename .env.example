# Contact form delivery through the NetSwagger Namecheap Private Email mailbox.
# Copy to .env.local for development; set the same names as secrets on your host for production.
# Never commit real values (.env and .env.* are gitignored), and never prefix these with VITE_,
# which would put them in the browser bundle. See docs/contact-setup.md.

# The mailbox the site logs in to and sends from. A separate mailbox such as website@netswagger.org
# is safest: if this password ever leaked, only that mailbox would be exposed, not info@.
SMTP_USER=website@netswagger.org

# That mailbox's password. Server-side only.
SMTP_PASS=

# Namecheap Private Email's outgoing server. Port 465 encrypts from the first byte, which is the
# only mode this site uses. Leave these unless the mail host changes.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# Where inquiries are delivered. Defaults to info@netswagger.org when unset.
CONTACT_TO_EMAIL=info@netswagger.org
